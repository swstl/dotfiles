#!/bin/bash

# Path to your Hyprland configuration file
CONFIG_FILE="$HOME/.config/hypr/themes/blur.lua"

# Check the current blur status
if grep -q "enabled = true" "$CONFIG_FILE"; then
    # Disable blur
    sed -i 's/enabled = true/enabled = false/' "$CONFIG_FILE"
else
    # Enable blur
    sed -i 's/enabled = false/enabled = true/' "$CONFIG_FILE"
fi

hyprctl reload
