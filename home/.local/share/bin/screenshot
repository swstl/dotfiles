#!/bin/bash

freeze_and_select() {
  # wayfreeze freezes screen, runs command, then unfreezes
  wayfreeze --hide-cursor &
  PID=$!
  sleep 0.1

  AREA=$(slurp -w 0)

  if [ -n "$AREA" ]; then
    grim -g "$AREA" - | wl-copy --type image/png
    notify-send "Screenshot copied!"
  fi

  kill $PID 2>/dev/null
}

case "$1" in
s|sf)  # Select Area (Frozen)
  freeze_and_select
  ;;

m)  # Active Monitor
  grim -o "$(hyprctl activeworkspace -j | jq -r '.monitor')" - | wl-copy --type image/png
  notify-send "Screenshot copied!"
  ;;

p)  # All Monitors
  grim - | wl-copy --type image/png
  notify-send "Screenshot copied!"
  ;;
esac
