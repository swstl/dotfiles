#!/bin/bash

CONFIG_FILE="$HOME/.config/.sus"
FALLBACK_PATH="$HOME/.dotfiles/Backgrounds/"

if [ -z "$1" ]; then
    echo "Usage: $0 path"
    exit 1
fi

PATH_IF_0="$1"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: Config file '$CONFIG_FILE' not found."
    exit 1
fi

VALUE=$(cat "$CONFIG_FILE")

if [ "$VALUE" = "0" ]; then
    echo "$PATH_IF_0"
else
    echo "$FALLBACK_PATH"
fi

